NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Web3Forms — used to email contact form submissions.
# Sign up free at https://web3forms.com with the inbox you want submissions delivered to
# (e.g. data24zone@gmail.com). It emails you an Access Key — paste it below.
# Must be NEXT_PUBLIC_ (not a server-only var): Web3Forms' free tier only accepts
# submissions made directly from the browser, so this key ships in client JS —
# that's expected, it's how Web3Forms is designed to be used.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-access-key
